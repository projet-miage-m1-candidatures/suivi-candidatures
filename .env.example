# Copier ce fichier en .env et choisir son propre mot de passe.
# Le fichier .env n'est jamais commité (voir .gitignore).
DB_NAME=suivicandidatures
DB_USER=suivicandidatures
DB_PASSWORD=change-moi
DB_PORT=5432

IA_FOURNISSEUR=faux
IA_MODELE=gpt-6-luna
IA_CLE=

# Variante gratuite en local avec Ollama (ollama pull mistral) :
# IA_FOURNISSEUR=openai
# IA_URL=http://localhost:11434
# IA_MODELE=mistral
# IA_CLE=ollama
